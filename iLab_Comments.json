      "parameters": {
        "jsCode": "// Gmail Trigger (simple:false) already decodes subject and body at the top level.\n// Just normalize and pass them on.\nconst item = $input.first().json;\n\nconst subject = item.subject || item.Subject || '(no subject)';\nconst from    = (typeof item.from === 'object') ? (item.from.text || item.from.value || '') : (item.from || '');\nconst text    = item.text || item.snippet || '(no body)';\n\nreturn [{ json: { subject, from, text: text.slice(0, 4000) } }];"
      },
