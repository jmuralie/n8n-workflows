        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'claude-haiku-4-5', max_tokens: 500, system: \"You summarize iLab core facility request notification emails. The email may be a forward \\u2014 ignore any forwarding wrapper (e.g. 'Thank you, Alex.') and focus on the iLab notification content that follows.\\n\\nFrom the notification extract:\\n- The request ID (e.g. SCCMTCRO-CAU-NT-Thomas-295)\\n- Who the message is addressed to (requester / PI / staff)\\n- The core facility name\\n- The service being provided\\n- Any specific action required, deadline, location, or status update\\n\\nAlways output in exactly this format (no extra text):\\nRequest info: <ID>\\nSummary: <2-3 sentences covering who, what service, and what action/update>\", messages: [{ role: 'user', content: 'Subject: ' + $json.subject + '\\\\n\\\\nEmail body:\\\\n' + ($json.text || '').slice(0, 4000) }] }) }}",
        "options": {
          "timeout": 30000
        }
