      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "48e124ea-18d2-4702-924f-6830375dc9db",
      "name": "Send Telegram Message",
