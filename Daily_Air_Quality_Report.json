      "id": "b7e3f21a-5c4d-4e8b-9f1a-2d6c8a0e3b5d",
      "name": "Fetch Pollen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 192]
    },
    {
      "parameters": {
        "jsCode": "const aq = $('Fetch Air Quality').first().json;\nconst pollen = $input.first().json;\nconst chatId = '8113726432';\nconst c = aq.current;\nconst p = pollen.data && pollen.data[0];\n\nconst aqiLabel = (v) => {\n  if (v <= 50)  return '\ud83d\udfe2 Good';\n  if (v <= 100) return '\ud83d\udfe1 Moderate';\n  if (v <= 150) return '\ud83d\udfe0 Unhealthy for sensitive groups';\n  if (v <= 200) return '\ud83d\udd34 Unhealthy';\n  if (v <= 300) return '\ud83d\udfe3 Very Unhealthy';\n  return '\u26ab Hazardous';\n};\n\nconst ozoneLabel = (v) => {\n  if (v < 60)  return '\ud83d\udfe2 Low';\n  if (v < 100) return '\ud83d\udfe1 Moderate';\n  if (v < 140) return '\ud83d\udfe0 High';\n  return '\ud83d\udd34 Very High';\n};\n\nconst dustLabel = (v) => {\n  if (v < 25)  return '\ud83d\udfe2 Low';\n  if (v < 50)  return '\ud83d\udfe1 Moderate';\n  if (v < 100) return '\ud83d\udfe0 High';\n  return '\ud83d\udd34 Very High';\n};\n\nconst pollenRiskEmoji = (risk) => {\n  const map = { 'Low': '\ud83d\udfe2', 'Moderate': '\ud83d\udfe1', 'High': '\ud83d\udfe0', 'Very High': '\ud83d\udd34' };\n  return (map[risk] || '\u26aa') + ' ' + (risk || 'N/A');\n};\n\nconst today = new Date().toLocaleDateString('en-US', {\n  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',\n  timeZone: 'America/Chicago'\n});\n\nconst pollenSection = p\n  ? `\n\n\ud83c\udf3f <b>Pollen Report</b>\n\ud83c\udf33 <b>Tree:</b> ${pollenRiskEmoji(p.Risk.tree_pollen)} (${p.Count.tree_pollen} grains/m\u00b3)\n\ud83c\udf3e <b>Grass:</b> ${pollenRiskEmoji(p.Risk.grass_pollen)} (${p.Count.grass_pollen} grains/m\u00b3)\n\ud83c\udf31 <b>Weed:</b> ${pollenRiskEmoji(p.Risk.weed_pollen)} (${p.Count.weed_pollen} grains/m\u00b3)`\n  : '\\n\\n\u26a0\ufe0f <b>Pollen data unavailable</b>';\n\nconst msg = `\ud83c\udf24 <b>Air Quality Report \u2014 ${today}</b>\n\n\ud83c\udf0d <b>Overall AQI:</b> ${c.us_aqi} \u2014 ${aqiLabel(c.us_aqi)}\n\ud83c\udf2b <b>PM10 (Dust):</b> ${c.pm10} \u00b5g/m\u00b3 \u2014 ${dustLabel(c.pm10)}\n\ud83d\udca8 <b>PM2.5 (Fine particles):</b> ${c.pm2_5} \u00b5g/m\u00b3\n\ud83e\uddea <b>Ozone:</b> ${c.ozone} \u00b5g/m\u00b3 \u2014 ${ozoneLabel(c.ozone)}\n\ud83c\udfdc <b>Dust:</b> ${c.dust} \u00b5g/m\u00b3 \u2014 ${dustLabel(c.dust)}${pollenSection}`;\n\nreturn [{ json: { message: msg, chatId } }];"
      },
      "id": "44b28590-1023-49e3-ac2a-9c168aea9d4f",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 192]
    },
